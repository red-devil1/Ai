EXPERIMENT 2
A* Search and Recursive Best-First Search (RBFS)
Step-by-step practical chapter | Source PDF pages 15–28
1. Aim
Implement A* and RBFS on the same weighted graph and compare the resulting paths and path costs.
2. Tools Required
Python 3.x; VS Code, PyCharm, IDLE, or Google Colab. No external packages are required.
3. Setup
Use Python 3 and an editor or notebook. No third-party packages are needed for this experiment.
4. Step-by-Step Procedure
Step 1: Create the file
1.	Create `exp2_astar_rbfs.py` in your practicals folder.
import heapq

graph = {
    "A": [("B", 1), ("C", 4)],
    "B": [("D", 2), ("E", 5)],
    "C": [("F", 3)],
    "D": [("G", 5)],
    "E": [("G", 1)],
    "F": [("G", 2)],
    "G": []
}
h = {"A": 5, "B": 4, "C": 3, "D": 3, "E": 1, "F": 2, "G": 0}

def astar(start, goal):
    pq = [(h[start], 0, start, [start])]
    best_cost = {start: 0}
    while pq:
        f, cost, node, path = heapq.heappop(pq)
        if node == goal:
            return path, cost
        if cost > best_cost.get(node, float("inf")):
            continue
        for nxt, edge_cost in graph[node]:
            new_cost = cost + edge_cost
            if new_cost < best_cost.get(nxt, float("inf")):
                best_cost[nxt] = new_cost
                heapq.heappush(pq, (new_cost + h[nxt], new_cost, nxt, path + [nxt]))
    return None, float("inf")

def rbfs(node, goal, cost, path, f_node, f_limit):
    if node == goal:
        return (path, cost), f_node
    successors = []
    for nxt, edge_cost in graph[node]:
        if nxt not in path:
            new_cost = cost + edge_cost
            f = max(new_cost + h[nxt], f_node)
            successors.append([f, nxt, new_cost, path + [nxt]])
    if not successors:
        return None, float("inf")
    while successors:
        successors.sort(key=lambda x: x[0])
        best = successors[0]
        if best[0] > f_limit:
            return None, best[0]
        alternative = successors[1][0] if len(successors) > 1 else float("inf")
        result, new_f = rbfs(best[1], goal, best[2], best[3],
                             best[0], min(f_limit, alternative))
        best[0] = new_f
        if result is not None:
            return result, new_f
    return None, float("inf")

start = input("Enter starting node (A-G): ").upper()
goal = input("Enter goal node (A-G): ").upper()
if start not in graph or goal not in graph:
    print("Invalid node. Enter A through G.")
else:
    a_path, a_cost = astar(start, goal)
    r_result, _ = rbfs(start, goal, 0, [start], h[start], float("inf"))
    print("\nA* path:", " -> ".join(a_path) if a_path else "Not found")
    print("A* total cost:", a_cost)
    if r_result:
        r_path, r_cost = r_result
        print("RBFS path:", " -> ".join(r_path))
        print("RBFS total cost:", r_cost)
    else:
        print("RBFS path not found")

